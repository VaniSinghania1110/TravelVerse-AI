{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(css|js)/(.*)",
      "dest": "/frontend/$1/$2"
    },
    {
      "src": "/(.*\\.(?:html|js|css|png|jpg|jpeg|gif|svg|ico|json|pdf|txt|woff2?))",
      "dest": "/frontend/$1"
    },
    {
      "src": "/",
      "dest": "/frontend/frontpage.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
